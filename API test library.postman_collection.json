    {
      "name": "ish",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const user = pm.response.json();\r",
              "\r",
              "pm.test(\"Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"id is a number\", function () {\r",
              "    pm.expect(user.id).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"name is a non-empty string\", function () {\r",
              "    pm.expect(user.name).to.be.a(\"string\").and.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"email looks valid\", function () {\r",
              "    pm.expect(user.email).to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/);\r",
              "});\r",
              "\r",
              "pm.test(\"nested field: address.city exists\", function () {\r",
              "    pm.expect(user.address).to.have.property(\"city\");\r",
              "});\r",
              "\r",
              "pm.test(\"nested field: company.name is a string\", function () {\r",
              "    pm.expect(user.company.name).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time under 1500 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
