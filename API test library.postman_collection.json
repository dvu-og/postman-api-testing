          "listen": "test",
          "script": {
            "exec": [
              "const posts = pm.response.json();\r",
              "\r",
              "pm.test(\"Returns an array of 100 posts\", function () {\r",
              "    pm.expect(posts).to.be.an(\"array\").with.lengthOf(100);\r",
              "});\r",
              "\r",
              "pm.test(\"Every post has exactly the expected fields\", function () {\r",
              "    posts.forEach(function (post) {\r",
              "        pm.expect(post).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"All ids are unique\", function () {\r",
              "    var ids = posts.map(function (p) { return p.id; });\r",
              "    pm.expect(new Set(ids).size).to.eql(ids.length);\r",
              "});"
